{
  "name": "hocuspocus",
  "version": "1.0.0",
  "description": "Hocuspocus server with SQLite persistence and REST API",
  "type": "module",
  "main": "./src/server.ts",
  "scripts": {
    "dev": "tsx watch ./src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "backup": "tsx ./src/extensions/backup.ts"
  },
  "license": "MIT",
  "dependencies": {
    "@hocuspocus/extension-logger": "^4.4.0",
    "@hocuspocus/extension-sqlite": "^4.4.0",
    "@hocuspocus/server": "^4.4.0",
    "@hono/node-server": "^2.0.12",
    "dotenv": "^17.4.2",
    "hono": "^4.12.32",
    "ws": "^8.21.1",
    "yjs": "^13.6.31"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.2",
    "@types/ws": "^8.18.1",
    "tsx": "^4.23.1",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=20.0.0"
  }
}
